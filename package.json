{
  "name": "corporate-sites-monorepo",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.9.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:la-nieve": "npm run dev --workspace=@corporativo/la-nieve",
    "dev:unimarka": "npm run dev --workspace=@corporativo/unimarka",
    "build": "npm run build --workspaces --if-present",
    "build:la-nieve": "npm run build --workspace=@corporativo/la-nieve",
    "build:unimarka": "npm run build --workspace=@corporativo/unimarka",
    "deploy:la-nieve": "npm run build:la-nieve && node scripts/package-standalone.mjs la-nieve",
    "deploy:unimarka": "npm run build:unimarka && node scripts/package-standalone.mjs unimarka",
    "start:la-nieve": "npm run start --workspace=@corporativo/la-nieve",
    "start:unimarka": "npm run start --workspace=@corporativo/unimarka",
    "lint": "eslint apps packages scripts/dev.mjs",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "format": "prettier --write apps packages scripts README.md PROJECT_GUIDE.md PROCESO_FASE_1.md package.json",
    "format:check": "prettier --check apps packages scripts README.md PROJECT_GUIDE.md PROCESO_FASE_1.md package.json"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.10",
    "prettier": "^3.9.5",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "allowScripts": {
    "sharp@0.34.5": true,
    "unrs-resolver@1.12.2": true
  }
}
