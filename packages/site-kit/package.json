{
  "name": "@corporativo/site-kit",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit --incremental false"
  },
  "sideEffects": [
    "./src/styles/globals.css"
  ],
  "files": [
    "src"
  ],
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./primitives": {
      "types": "./src/primitives.ts",
      "import": "./src/primitives.ts",
      "default": "./src/primitives.ts"
    },
    "./config": {
      "types": "./src/config/index.ts",
      "import": "./src/config/index.ts",
      "default": "./src/config/index.ts"
    },
    "./server/forms": {
      "types": "./src/server/forms.ts",
      "import": "./src/server/forms.ts",
      "default": "./src/server/forms.ts"
    },
    "./styles.css": "./src/styles/globals.css"
  },
  "peerDependencies": {
    "next": "^16.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "gsap": "^3.15.0",
    "lenis": "^1.3.25",
    "lucide-react": "^1.24.0",
    "mysql2": "^3.24.4",
    "next-themes": "^0.4.6",
    "tailwind-merge": "^3.6.0"
  }
}
