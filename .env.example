DATABASE_HOST=
DATABASE_PORT=3306
DATABASE_NAME=
DATABASE_USER=
DATABASE_PASSWORD=
DATABASE_SSL=false
DATABASE_CONNECTION_LIMIT=5
DATABASE_QUEUE_LIMIT=50

RESEND_API_KEY=
RESEND_FROM_EMAIL=
RESEND_FROM_NAME=
RESEND_CAREERS_TO_LA_NIEVE=
RESEND_PQRS_TO_LA_NIEVE=
RESEND_SUPPLIERS_TO_LA_NIEVE=
RESEND_CAREERS_TO_UNIMARKA=
